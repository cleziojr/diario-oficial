# Escolha o provider: "openrouter" (padrão) ou "ollama"
LLM_PROVIDER=ollama

# --- OpenRouter (necessário apenas se LLM_PROVIDER=openrouter) ---
OPENROUTER_API_KEY=

# --- Ollama (necessário apenas se LLM_PROVIDER=ollama) ---
# Em Docker Compose o host padrão é http://ollama:11434
# Localmente use http://localhost:11434
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Texto de entrada para teste via CLI (opcional)
# INPUT_TEXT=
